	var LS_LEAD = 'b24fc_lead_id';       // ID черновика лида
	var LS_SESSION = 'b24fc_draft_session'; // один незавершённый лид на браузерный сеанс
	var finalized = false;               // форма отправлена — поздний черновик не восстанавливает id
	var pendingDrafts = new WeakMap();    // активный /draft для конкретной формы
	var draftQueue = Promise.resolve();   // не даём нескольким формам одновременно создать лид
	var queuedDrafts = 0;

	/* --------- согласие ---------
	 * Согласие считается данным по факту нахождения на сайте (баннер лишь информирует).
	 * Кнопку жать не нужно — перехват работает сразу.
	 */
	function hasConsent() {
		return true;
	}

	/* --------- хранилище ID лида --------- */
	function getLeadId() {
		try { return parseInt(localStorage.getItem(LS_LEAD) || '0', 10) || 0; }
		catch (e) { return 0; }
	}
	function setLeadId(id) {
		try {
			if (id) localStorage.setItem(LS_LEAD, String(id));
			else localStorage.removeItem(LS_LEAD);
		} catch (e) {}
		syncLeadIdToForms(id);
	}

	function makeSessionId() {
		if (window.crypto && typeof window.crypto.randomUUID === 'function') {
			return window.crypto.randomUUID();
		}
		return Date.now().toString(36) + '-' + Math.random().toString(36).slice(2) +
			'-' + Math.random().toString(36).slice(2);
	}

	function getSessionId() {
		try {
			var id = localStorage.getItem(LS_SESSION) || '';
			if (!id) {
				id = makeSessionId();
				localStorage.setItem(LS_SESSION, id);
			}
			return id;
		} catch (e) {
			if (!window.__b24fcSession) window.__b24fcSession = makeSessionId();
			return window.__b24fcSession;
		}
	}

	function clearAfterSubmit() {
		setLeadId(0);
		try { localStorage.removeItem(LS_SESSION); } catch (e) {}
		window.__b24fcSession = '';
	}

	/* Прячем lead_id черновика скрытым полем во все формы. Тогда при реальной
	 * отправке внешний интегратор получит его в payload и обновит ТОТ ЖЕ лид
	 * (crm.lead.update), а не создаст второй — дублей между плагином и интегратором нет. */
	function syncLeadIdToForms(id) {
		var forms = document.querySelectorAll('form');
		for (var i = 0; i < forms.length; i++) {
			var inp = forms[i].querySelector('input[name="b24fc_lead_id"]');
			if (!inp) {
				inp = document.createElement('input');
				inp.type = 'hidden';
				inp.name = 'b24fc_lead_id';
				forms[i].appendChild(inp);
			}
			inp.value = id ? String(id) : '';

			var hp = forms[i].querySelector('input[name="b24fc_website"]');
			if (!hp) {
				hp = document.createElement('input');
				hp.type = 'text';
				hp.name = 'b24fc_website';
				hp.value = '';
				hp.tabIndex = -1;
				hp.autocomplete = 'off';
				hp.setAttribute('aria-hidden', 'true');
				hp.style.position = 'absolute';
				hp.style.left = '-10000px';
				hp.style.width = '1px';
				hp.style.height = '1px';
				hp.style.opacity = '0';
				forms[i].appendChild(hp);
			}
		}
	}

	/* --------- детект полей формы --------- */
	// Ищем поля по type, name, id, placeholder, autocomplete — без привязки к плагину.
	function detectFields(form) {
		var res = { name: '', email: '', phone: '', honeypot: '' };
		var hp = form.querySelector('input[name="b24fc_website"]');
		res.honeypot = hp ? (hp.value || '').trim() : '';
		var inputs = form.querySelectorAll('input, textarea');

		inputs.forEach(function (el) {
			if (el.disabled || el.type === 'hidden' || el.type === 'submit' || el.type === 'button') return;
			var v = (el.value || '').trim();
			if (!v) return;

			var hay = [el.type, el.name, el.id, el.placeholder, el.getAttribute('autocomplete')]
				.join(' ').toLowerCase();

			if (el.type === 'email' || /e-?mail|почт|mail/.test(hay)) {
				if (!res.email && /\S+@\S+\.\S+/.test(v)) res.email = v;
				return;
			}
			if (el.type === 'tel' || /phone|tel|телефон|моб|whats|номер/.test(hay)) {
				if (!res.phone) res.phone = v;
				return;
			}
			if (/name|имя|fio|фио|contact|представ/.test(hay)) {
				if (!res.name) res.name = v;
				return;
			}
			// эвристика: значение похоже на email/телефон, даже если поле не размечено
			if (!res.email && /\S+@\S+\.\S+/.test(v)) { res.email = v; return; }
			if (!res.phone && /^[\d\s()+\-]{6,}$/.test(v)) { res.phone = v; return; }
		});
		// Направление/отдел и источник — из скрытых полей формы (fedelis: direction, url, form).
		var d = form.querySelector('input[name="direction"]');
		res.direction = d ? (d.value || '') : '';
		var fn = form.querySelector('input[name="form"]');
		res.form = fn ? (fn.value || '') : '';
		var ya = form.querySelector('input[name="yaClientID"]');
		res.yaClientID = ya ? (ya.value || '') : '';
		var topicCode = form.querySelector('input[name="request_topic_code"]');
		var topicName = form.querySelector('input[name="request_topic_name"]');
		var cf7Id = form.querySelector('input[name="_wpcf7"]');
		res.request_topic_code = topicCode ? (topicCode.value || '') : '';
		res.request_topic_name = topicName ? (topicName.value || '') : '';
		res.request_topic_form_key = cf7Id && cf7Id.value ? 'cf7:' + cf7Id.value : '';
		// Недопечатанный телефон (меньше 10 цифр) не отправляем вовсе:
		// иначе в CRM попадает обрубок «+7989», по которому стреляет СМС-робот.
		if (res.phone && res.phone.replace(/[^\d]/g, '').length < 10) res.phone = '';
		return res;
	}

	function hasSomething(f) {
		if (f.honeypot) return false;
		// Черновик имеет смысл, только когда есть КУДА связаться:
		// полный телефон (≥10 цифр) или валидный email. Одного имени мало.
		return (f.email && /\S+@\S+\.\S+/.test(f.email)) ||
			(f.phone && f.phone.replace(/[^\d]/g, '').length >= 10);
	}

	/* --------- сеть --------- */

	function deliveryFailure(form) {
		if (!form || !form.querySelector || !form.appendChild) return;
		var el = form.querySelector('[data-b24fc-status]');
		if (!el) { el = document.createElement('p'); el.setAttribute('data-b24fc-status', '1'); el.setAttribute('role', 'alert'); form.appendChild(el); }
		el.textContent = 'Отправка не подтверждена. Сохраните введённый текст. Если ошибка повторяется, свяжитесь с нами по телефону на сайте.';
	}
	function post(path, data) {
		return fetch(CFG.root + path, {
			method: 'POST',
			headers: {
				'Content-Type': 'application/json',
				'X-WP-Nonce': CFG.nonce
			},
			body: JSON.stringify(data),
			keepalive: true
		}).then(function (r) { return r.json().then(function(data){ if (r.status === 400 && data && data.code === 'rest_invalid_json') data={ok:false,reason:'rest_invalid_json'}; if (!r.ok && (!data || data.ok !== false)) return null; if (data && typeof data === 'object') data.__b24fcHttpStatus=r.status; return data; }); }).catch(function () { return null; });
	}

	function sendDraft(fields) {
		var payload = {
			name: fields.name,
			email: fields.email,
			phone: fields.phone,
			direction: fields.direction || '',
			form: fields.form || '',
			yaClientID: fields.yaClientID || '',
			request_topic_code: fields.request_topic_code || '',
			request_topic_name: fields.request_topic_name || '',
			request_topic_form_key: fields.request_topic_form_key || '',
			page: location.href,
			referrer: document.referrer || '',
			lead_id: getLeadId(),
			session_id: getSessionId(),
			honeypot: fields.honeypot || ''
		};
		return post('draft', payload).then(function (res) {
			if (finalized) return res; // форму уже отправили — не воскрешаем черновик
			if (res && res.ok && res.lead_id) setLeadId(res.lead_id);
			return res;
		});
	}

	function sendDraftForForm(form, fields) {
		var pending = pendingDrafts.get(form);
		if (pending) return pending;

		queuedDrafts++;
		pending = draftQueue.then(function () {
			return sendDraft(fields);
		}, function () {
			return sendDraft(fields);
		});
		draftQueue = pending.catch(function () { return null; });
		pendingDrafts.set(form, pending);
		var clear = function (res) {
			form.__b24fcDraftOutcome = res && res.ok === true && Number.isInteger(res.lead_id) && res.lead_id > 0 ? 'confirmed' : res && res.ok === false && ((res.reason === 'bad_nonce' && res.__b24fcHttpStatus === 403) || (res.reason === 'empty' && res.__b24fcHttpStatus === 200) || (res.reason === 'rest_invalid_json' && res.__b24fcHttpStatus === 400)) ? 'rejected_before_write' : 'unknown';
			if (pendingDrafts.get(form) === pending) pendingDrafts.delete(form);
			queuedDrafts = Math.max(0, queuedDrafts - 1);
			return res;
		};
		return pending.then(clear, function () { return clear(null); });
	}

	function sendFinalize(fields, form) {
		var id = getLeadId();
		return post('finalize', {
			name: fields.name,
			email: fields.email,
			phone: fields.phone,
			direction: fields.direction || '',
			form: fields.form || '',
			yaClientID: fields.yaClientID || '',
			request_topic_code: fields.request_topic_code || '',
			request_topic_name: fields.request_topic_name || '',
			request_topic_form_key: fields.request_topic_form_key || '',
			page: location.href,
			referrer: document.referrer || '',
			lead_id: id,
			session_id: getSessionId()
		}).then(function (res) {
			if (res && res.ok === true && Number.isInteger(res.lead_id) && res.lead_id > 0) {
				clearAfterSubmit();
			} else {
				deliveryFailure(form);
			}
			return res;
		});
	}

	/* --------- подключение к формам --------- */
	var timers = new WeakMap();

	function cancelScheduledDraft(form) {
		var t = timers.get(form);
		if (t) clearTimeout(t);
		timers.delete(form);
	}

	/**
	 * Перед финальной отправкой дожидаемся уже начатого /draft или создаём
	 * черновик сразу. После этого b24fc_lead_id гарантированно попадает в FormData,
	 * а внешний интегратор обновляет тот же лид вместо создания второго.
	 */
	function prepareForSubmit(form) {
		cancelScheduledDraft(form);
		var pending = pendingDrafts.get(form);
		var ready = pending || Promise.resolve(null);

		return ready.then(function () {
			var id = getLeadId();
			if (id) return id;

			var f = detectFields(form);
			if (!hasSomething(f)) { form.__b24fcDraftOutcome='not_attempted'; return 0; }
			form.__b24fcLast = f;
			finalized = false;
			return sendDraftForForm(form, f).then(function (res) {
				return res && res.ok && res.lead_id ? parseInt(res.lead_id, 10) || 0 : getLeadId();
			});
		}).then(function (id) {
			finalized = true;
			cancelScheduledDraft(form);
			syncLeadIdToForms(id || 0);
			return id || 0;
		});
	}

	function attach(form) {
		if (form.closest("#nsvc-root") && form.getAttribute("data-nsvc-enabled") === "1") return; // task14: final submit owns this batch
		if (form.__b24fcBound) return;
		form.__b24fcBound = true;

		function schedule() {
			if (!hasConsent()) return;
			finalized = false; // пользователь снова печатает — начинается новый черновик
			var t = timers.get(form);
			if (t) clearTimeout(t);
			t = setTimeout(function () {
				var f = detectFields(form);
				if (hasSomething(f)) {
					form.__b24fcLast = f;
					sendDraftForForm(form, f);
				}
			}, CFG.debounceMs || 1500);
			timers.set(form, t);
		}

		form.addEventListener('input', schedule, true);
		form.addEventListener('change', schedule, true);
		// Маски телефона (jquery.inputmask на favorit) перехватывают клавиши и меняют
		// value программно — нативный 'input' не диспатчится. keyup/focusout/paste
		// маска не глушит, поэтому дублируем планировщик на них.
		form.addEventListener('keyup', schedule, true);
		form.addEventListener('focusout', schedule, true);
		form.addEventListener('paste', schedule, true);

		// Обычная отправка формы.
		form.addEventListener('submit', function () {
			// Если финализацию делает внешний интегратор (он получит lead_id
			// скрытым полем и обновит тот же лид) — плагин сам лид не трогает,
			// но после отправки сбрасывает черновик, чтобы СЛЕДУЮЩАЯ заявка
			// не перезаписала уже завершённый лид. setTimeout(0) — чтобы интегратор
			// успел синхронно считать lead_id из формы до очистки.
			if (CFG.externalFinalize) {
				finalized = true;
				var pend = timers.get(form);
				if (pend) clearTimeout(pend); // не запускаем новый черновик после отправки
				// State is cleared only after an accepted CF7 response, not the submit event.
				return;
			}
			// CF7 шлёт submit через AJAX и вызывает его ДАЖЕ при неудачной валидации.
			// Для CF7 финализируем только по успешному wpcf7mailsent (ниже), иначе
			// недоотправленный лид ошибочно помечался бы "заполнено".
			if (form.classList.contains('wpcf7-form') || form.closest('.wpcf7')) return;
			var f = detectFields(form);
			if (hasSomething(f) || getLeadId()) sendFinalize(f, form);
		}, true);
	}

	function scan() {
		document.querySelectorAll('form').forEach(attach);
		syncLeadIdToForms(getLeadId());
	}

	/* --------- Contact Form 7 --------- */
	// CF7 отправляет через AJAX; успешная отправка = событие wpcf7mailsent.
	document.addEventListener('wpcf7mailsent', function (e) {

		// e.target — обёртка .wpcf7; сама форма (и её __b24fcLast) внутри.
		var wrap = e.target && e.target.querySelector ? e.target : document;
		var formEl = (wrap.matches && wrap.matches('form')) ? wrap
			: (wrap.querySelector ? wrap.querySelector('form') : null);
		// Берём последние захваченные значения черновика; CF7 к этому моменту
		// мог уже очистить поля, поэтому detectFields — только запасной вариант.
		if (CFG.externalFinalize) {
			var response = e.detail && e.detail.apiResponse;
			if (response && response.status === 'mail_sent' && (!response.fl19 || (response.fl19.ok === true && Number.isInteger(response.fl19.lead_id) && response.fl19.lead_id > 0))) clearAfterSubmit();
			return;
		}
		var f = (formEl && formEl.__b24fcLast) || detectFields(formEl || wrap);
		if (hasSomething(f) || getLeadId()) sendFinalize(f, formEl);
	}, false);

	/* --------- досыл при закрытии вкладки --------- */
	window.addEventListener('beforeunload', function () {
		if (!hasConsent()) return;
		// Активный keepalive-запрос уже дойдёт до сервера. Второй beacon в этот
		// момент раньше создавал параллельный лид с теми же данными.
		if (queuedDrafts > 0) return;
		var forms = document.querySelectorAll('form');
		for (var i = 0; i < forms.length; i++) {
			if (forms[i].closest("#nsvc-root") && forms[i].getAttribute("data-nsvc-enabled") === "1") continue; // task14: no duplicate unload draft
			var f = detectFields(forms[i]);
			if (hasSomething(f)) {
				var blob = new Blob([JSON.stringify({
					name: f.name, email: f.email, phone: f.phone,
					direction: f.direction || '', form: f.form || '', yaClientID: f.yaClientID || '',
					request_topic_code: f.request_topic_code || '',
					request_topic_name: f.request_topic_name || '',
					request_topic_form_key: f.request_topic_form_key || '',
					page: location.href, referrer: document.referrer || '',
					lead_id: getLeadId(), session_id: getSessionId(),
					honeypot: f.honeypot || '', _wpnonce: CFG.nonce
				})], { type: 'application/json' });
				// sendBeacon не шлёт кастомные заголовки, поэтому nonce идёт в теле;
				// сервер принимает nonce и из заголовка, и из тела (см. PHP при желании расширить).
				try { navigator.sendBeacon(CFG.root + 'draft', blob); } catch (e2) {}
				break;
			}
		}
	});

	/* --------- init --------- */
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', scan);
	} else {
		scan();
	}
	// Формы, добавленные динамически (попапы, Elementor и т.п.).
	var mo = new MutationObserver(scan);
	mo.observe(document.documentElement, { childList: true, subtree: true });

	window.B24FCatcher = {
		prepareForSubmit: prepareForSubmit,
		getLeadId: getLeadId,
		draftOutcome: function(form) { return form.__b24fcDraftOutcome || 'unknown'; },
		clearAfterSubmit: clearAfterSubmit
	};
})();

}
